<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Reason_Required</fullName>
    <active>true</active>
    <description>A rejected request must state why.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Rejected"), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
    <errorDisplayField>Rejection_Reason__c</errorDisplayField>
    <errorMessage>A rejection reason is required when the request is rejected.</errorMessage>
</ValidationRule>
