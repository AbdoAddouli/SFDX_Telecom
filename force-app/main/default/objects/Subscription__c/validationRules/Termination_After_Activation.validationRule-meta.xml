<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Termination_After_Activation</fullName>
    <active>true</active>
    <description>A line cannot terminate before it activates.</description>
    <errorConditionFormula>AND(
   NOT(ISBLANK(Termination_Date__c)),
   NOT(ISBLANK(Activation_Date__c)),
   Termination_Date__c &lt; Activation_Date__c)</errorConditionFormula>
    <errorDisplayField>Termination_Date__c</errorDisplayField>
    <errorMessage>Termination date cannot be before the activation date.</errorMessage>
</ValidationRule>
