<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Date_After_Start</fullName>
    <active>true</active>
    <description>End date must be strictly after the start date.</description>
    <errorConditionFormula>OR(ISBLANK(End_Date__c), End_Date__c &lt;= Start_Date__c)</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>End date must be after the start date.</errorMessage>
</ValidationRule>
