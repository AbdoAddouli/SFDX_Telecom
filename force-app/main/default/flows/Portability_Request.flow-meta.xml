<?xml version="1.0" encoding="utf-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <name>Submit_Port</name>
    <label>Submit Port Request</label>
    <locationX>800</locationX>
    <locationY>300</locationY>
    <actionName>PortabilityService</actionName>
    <actionType>apex</actionType>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <connector>
      <targetReference>Check_Result</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Screen_Error</targetReference>
    </faultConnector>
    <inputParameters>
      <name>direction</name>
      <value><elementReference>direction</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>accountId</name>
      <value><elementReference>accountId</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>contactId</name>
      <value><elementReference>contactId</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>subscriptionId</name>
      <value><elementReference>subscriptionId</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>requestedMsisdn</name>
      <value><elementReference>requestedMsisdn</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>channel</name>
      <value><elementReference>channel</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>customerComment</name>
      <value><elementReference>customerComment</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>goodwillWaiver</name>
      <value><elementReference>goodwillWaiver</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>goodwillJustification</name>
      <value><elementReference>goodwillJustification</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>priority</name>
      <value><elementReference>priority</elementReference></value>
    </inputParameters>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </actionCalls>
  <decisions>
    <name>Check_Result</name>
    <label>Port Submitted?</label>
    <locationX>1000</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Screen_Failed</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Failed</defaultConnectorLabel>
    <rules>
      <name>Submitted</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Submit_Port.success</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue><booleanValue>true</booleanValue></rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Success</targetReference>
      </connector>
    </rules>
  </decisions>
  <description>UC-LIF-07 phase one. Submits an inbound or outbound number port to BSS and creates the shared lifecycle request and Case. The MSISDN is never changed by this flow.</description>
  <interviewLabel>Portability Request {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Portability Request</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value><stringValue>LightningFlowBuilder</stringValue></value>
  </processMetadataValues>
  <processType>Flow</processType>
  <screens>
    <name>Screen_Intake</name>
    <label>Portability Request</label>
    <locationX>200</locationX>
    <locationY>300</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Submit_Port</targetReference>
    </connector>
    <fields>
      <name>Guidance</name>
      <fieldText>Submits the port to BSS and creates the linked request and Case. Inbound sets a new number on the line; outbound releases the current number. The MSISDN is unchanged until the donor confirmation step. Valid channels: Advisor, Portal, API, Batch.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>direction</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>accountId</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>contactId</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>subscriptionId</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>requestedMsisdn</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>channel</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>customerComment</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>goodwillWaiver</name>
      <fieldType>InputField</fieldType>
      <dataType>Boolean</dataType>
      <defaultValue><booleanValue>false</booleanValue></defaultValue>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>goodwillJustification</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>priority</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>false</isRequired>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Success</name>
    <label>Port Submitted</label>
    <locationX>1200</locationX>
    <locationY>300</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Success_Message</name>
      <fieldText>{!Submit_Port.message}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Request</name>
      <fieldText>Request: {!Submit_Port.requestId}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Case</name>
      <fieldText>Case: {!Submit_Port.caseId}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Status</name>
      <fieldText>Status: {!Submit_Port.status}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Reference</name>
      <fieldText>BSS Reference: {!Submit_Port.portRequestReference}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Fee</name>
      <fieldText>Calculated Fee: {!Submit_Port.calculatedFee}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Failed</name>
    <label>Port Not Submitted</label>
    <locationX>1000</locationX>
    <locationY>500</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Failed_Message</name>
      <fieldText>{!Submit_Port.message}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Failed_Guidance</name>
      <fieldText>Review the values and retry. No request or Case was committed.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Error</name>
    <label>Port Intake Error</label>
    <locationX>800</locationX>
    <locationY>500</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Error_Message</name>
      <fieldText>The port request could not be completed. No changes were committed. Review the entries and retry.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Screen_Intake</targetReference>
    </connector>
  </start>
  <status>Active</status>
</Flow>
