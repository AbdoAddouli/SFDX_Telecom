<?xml version="1.0" encoding="utf-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <name>Activate_Order</name>
    <label>Activate Order</label>
    <locationX>1600</locationX>
    <locationY>450</locationY>
    <actionName>ActivationService</actionName>
    <actionType>apex</actionType>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <connector>
      <targetReference>Get_Updated_Order</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Screen_Unexpected_Error</targetReference>
    </faultConnector>
    <inputParameters>
      <name>orderIds</name>
      <value>
        <elementReference>recordId</elementReference>
      </value>
    </inputParameters>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </actionCalls>
  <apiVersion>68.0</apiVersion>
  <decisions>
    <name>Check_Order_Found</name>
    <label>Order Found?</label>
    <locationX>400</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Check_Already_Activated</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Order Found</defaultConnectorLabel>
    <rules>
      <name>Order_Not_Found</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Get_Order.Id</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>true</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Order_Not_Found</targetReference>
      </connector>
      <label>Order Not Found</label>
    </rules>
  </decisions>
  <decisions>
    <name>Check_Already_Activated</name>
    <label>Already Activated?</label>
    <locationX>600</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Check_Ready</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Not Activated</defaultConnectorLabel>
    <rules>
      <name>Already_Activated</name>
      <conditionLogic>or</conditionLogic>
      <conditions>
        <leftValueReference>Get_Order.Activation_State__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <stringValue>Activated</stringValue>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Order.Status</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <stringValue>Activated</stringValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Already_Activated</targetReference>
      </connector>
      <label>Already Activated</label>
    </rules>
  </decisions>
  <decisions>
    <name>Check_Ready</name>
    <label>Ready to Activate?</label>
    <locationX>800</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Check_Wizard_Flag</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Ready</defaultConnectorLabel>
    <rules>
      <name>Not_Ready</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Get_Order.Activation_State__c</leftValueReference>
        <operator>NotEqualTo</operator>
        <rightValue>
          <stringValue>Ready</stringValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Not_Ready</targetReference>
      </connector>
      <label>Not Ready</label>
    </rules>
  </decisions>
  <decisions>
    <name>Check_Wizard_Flag</name>
    <label>Wizard Enabled?</label>
    <locationX>1000</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Check_BSS_Flag</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Wizard Enabled</defaultConnectorLabel>
    <rules>
      <name>Wizard_Disabled</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>$Setup.ATS_Feature_Flags__c.Wizard_Enabled__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Wizard_Disabled</targetReference>
      </connector>
      <label>Wizard Disabled</label>
    </rules>
  </decisions>
  <decisions>
    <name>Check_BSS_Flag</name>
    <label>BSS Provisioning Enabled?</label>
    <locationX>1200</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Screen_Confirm</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>BSS Enabled</defaultConnectorLabel>
    <rules>
      <name>BSS_Disabled</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>$Setup.ATS_Feature_Flags__c.BSS_Provisioning_Enabled__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Confirm_BSS_Disabled</targetReference>
      </connector>
      <label>BSS Disabled</label>
    </rules>
  </decisions>
  <decisions>
    <name>Check_Activation_Succeeded</name>
    <label>Activation Succeeded?</label>
    <locationX>2000</locationX>
    <locationY>450</locationY>
    <defaultConnector>
      <targetReference>Screen_Activation_Failed</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Activation Failed</defaultConnectorLabel>
    <rules>
      <name>Activation_Succeeded</name>
      <conditionLogic>or</conditionLogic>
      <conditions>
        <leftValueReference>Get_Updated_Order.Activation_State__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <stringValue>Activated</stringValue>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Updated_Order.Status</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <stringValue>Activated</stringValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Activation_Succeeded</targetReference>
      </connector>
      <label>Activation Succeeded</label>
    </rules>
  </decisions>
  <description>UC-COM-05 entry point for order activation. The Flow provides confirmation and a friendly error surface; ActivationService keeps the transaction atomic, idempotent and BSS-aware. A BSS-off action still calls ActivationService so the order stays Ready with an operations-visible Failure Reason.</description>
  <interviewLabel>Validate the Order {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Validate the Order</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processType>Flow</processType>
