    </fields>
    <fields>
      <name>Order_Status</name>
      <fieldText>Status: {!Get_Order.Status}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Activation_State</name>
      <fieldText>Activation State: {!Get_Order.Activation_State__c}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Confirmation</name>
      <fieldText>Next Step: Validate this order and start activation. Assets, subscriptions and engagements are created atomically. If BSS cannot confirm provisioning, no partial activation is committed and the order returns to Ready.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
