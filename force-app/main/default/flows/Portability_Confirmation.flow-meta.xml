<?xml version="1.0" encoding="utf-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <name>Apply_Confirmation</name>
    <label>Apply Port Confirmation</label>
    <locationX>800</locationX>
    <locationY>300</locationY>
    <actionName>PortabilityConfirmationService</actionName>
    <actionType>apex</actionType>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <connector>
      <targetReference>Check_Result</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Screen_Error</targetReference>
    </faultConnector>
    <inputParameters>
      <name>requestId</name>
      <value><elementReference>requestId</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>confirmationReference</name>
      <value><elementReference>confirmationReference</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>outcome</name>
      <value><elementReference>outcome</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>rejectionReason</name>
      <value><elementReference>rejectionReason</elementReference></value>
    </inputParameters>
    <inputParameters>
      <name>customerComment</name>
      <value><elementReference>customerComment</elementReference></value>
    </inputParameters>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </actionCalls>
  <decisions>
    <name>Check_Result</name>
    <label>Confirmation Applied?</label>
    <locationX>1000</locationX>
    <locationY>300</locationY>
    <defaultConnector>
      <targetReference>Screen_Failed</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Failed</defaultConnectorLabel>
    <rules>
      <name>Processed</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Apply_Confirmation.success</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue><booleanValue>true</booleanValue></rightValue>
      </conditions>
      <connector>
        <targetReference>Screen_Success</targetReference>
      </connector>
    </rules>
  </decisions>
  <description>UC-LIF-07 phase two. Applies a confirmed inbound or outbound port to the subscription, or records a donor rejection. Only confirmed ports change the MSISDN.</description>
  <interviewLabel>Portability Confirmation {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Portability Confirmation</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value><stringValue>LightningFlowBuilder</stringValue></value>
  </processMetadataValues>
  <processType>Flow</processType>
  <screens>
    <name>Screen_Confirmation</name>
    <label>Portability Confirmation</label>
    <locationX>200</locationX>
    <locationY>300</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Apply_Confirmation</targetReference>
    </connector>
    <fields>
      <name>Guidance</name>
      <fieldText>Apply the donor outcome for an approved port request. Outcome Confirmed updates the MSISDN after the BSS apply call. Outcome Rejected closes the request and leaves the MSISDN unchanged. Confirmation reference is required for Confirmed; rejection reason is required for Rejected.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>requestId</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>confirmationReference</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>outcome</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>rejectionReason</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>customerComment</name>
      <fieldType>InputField</fieldType>
      <dataType>String</dataType>
      <isRequired>false</isRequired>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Success</name>
    <label>Confirmation Applied</label>
    <locationX>1200</locationX>
    <locationY>300</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Success_Message</name>
      <fieldText>{!Apply_Confirmation.message}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Request</name>
      <fieldText>Request: {!Apply_Confirmation.requestId}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Status</name>
      <fieldText>Status: {!Apply_Confirmation.status}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Success_Msisdn</name>
      <fieldText>Applied MSISDN: {!Apply_Confirmation.appliedMsisdn}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Failed</name>
    <label>Confirmation Not Applied</label>
    <locationX>1000</locationX>
    <locationY>500</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Failed_Message</name>
      <fieldText>{!Apply_Confirmation.message}</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Failed_Guidance</name>
      <fieldText>Review the request status and retry. No MSISDN change was committed.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Error</name>
    <label>Confirmation Error</label>
    <locationX>800</locationX>
    <locationY>500</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Error_Message</name>
      <fieldText>The confirmation could not be applied. No changes were committed. Review the entries and retry.</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Screen_Confirmation</targetReference>
    </connector>
  </start>
  <status>Active</status>
</Flow>
