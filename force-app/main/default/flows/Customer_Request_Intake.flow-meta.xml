  <description>UC-LIF-08 shared intake flow. Creates the Customer Request and linked Case, resolves the impacted engagement, computes the fee server side, and routes approval by the shared threshold. Info requests intentionally create no Case.</description>
  <interviewLabel>Customer Request Intake {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Customer Request Intake</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processType>Flow</processType>
  <screens>
    <name>Screen_Intake</name>
    <label>Customer Request Intake</label>
    <locationX>200</locationX>
    <locationY>300</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
